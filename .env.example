# Zepp Health 配置
# 优先级：CLI 参数 > config.json > 环境变量 > cookie

# 方式一：直接配置 token
ZEPP_APP_TOKEN=your_app_token_here
ZEPP_USER_ID=your_user_id_here
ZEPP_HOST=api-mifit-cn3.zepp.com

# 方式二：从 cookie 解析（从 Zepp 网页端抓取）
# ZEPP_COOKIE=userid=xxx; apptoken=xxx; region=1

# 可选
ZEPP_TIMEZONE=Asia/Shanghai
ZEPP_APP_PLATFORM=ios_phone
ZEPP_LANG=zh
ZEPP_COUNTRY=CN
