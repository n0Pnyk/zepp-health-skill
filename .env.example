# Zepp Health Configuration
# Priority: CLI args > config.json > environment variables > cookie

# Option 1: Direct token configuration
ZEPP_APP_TOKEN=your_app_token_here
ZEPP_USER_ID=your_user_id_here
ZEPP_HOST=api-mifit-cn3.zepp.com

# Option 2: Parse from cookie (grab from Zepp web portal)
# ZEPP_COOKIE=userid=xxx; apptoken=xxx; region=1

# Optional
ZEPP_TIMEZONE=Asia/Shanghai
ZEPP_APP_PLATFORM=ios_phone
ZEPP_LANG=zh
ZEPP_COUNTRY=CN
